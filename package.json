{
  "name": "monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:iching": "npm run dev --prefix iching",
    "dev:tarot": "npm run dev --prefix tarotnow",
    "build:iching": "npm run build --prefix iching",
    "build:tarot": "npm run build --prefix tarotnow",
    "install:iching": "npm install --prefix iching",
    "install:tarot": "npm install --prefix tarotnow",
    "install:all": "npm install --prefix iching && npm install --prefix tarotnow",
    "lint:iching": "npm run lint --prefix iching",
    "lint:tarot": "npm run lint --prefix tarotnow"
  }
}
