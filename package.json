{
  "name": "monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:iching": "npm run dev --prefix iching",
    "dev:tarot": "npm run dev --prefix tarotnow",
    "dev:tuvi": "npm run dev --prefix tuvinow",
    "dev:talk": "npm run dev --prefix talkwithme",
    "build:iching": "npm run build --prefix iching",
    "build:tarot": "npm run build --prefix tarotnow",
    "build:tuvi": "npm run build --prefix tuvinow",
    "build:talk": "npm run build --prefix talkwithme",
    "build:all": "npm run build --prefix iching && npm run build --prefix tarotnow && npm run build --prefix tuvinow && npm run build --prefix talkwithme",
    "install:iching": "npm install --prefix iching",
    "install:tarot": "npm install --prefix tarotnow",
    "install:tuvi": "npm install --prefix tuvinow",
    "install:talk": "npm install --prefix talkwithme",
    "install:all": "npm install --prefix iching && npm install --prefix tarotnow && npm install --prefix tuvinow && npm install --prefix talkwithme",
    "lint:iching": "npm run lint --prefix iching",
    "lint:tarot": "npm run lint --prefix tarotnow",
    "lint:tuvi": "npm run lint --prefix tuvinow"
  }
}
